---
// BaseLayout.astro
import '../styles/global.css';
import Breadcrumbs from '../components/Breadcrumbs.astro';
export interface Props {
  title: string;
  description: string;
  keywords?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
}
const {
  title,
  description,
  keywords = "",
  canonical = `https://agecalconline.com${Astro.url.pathname}`,
  ogImage = 'https://agecalconline.com/og-image.png',
  ogType = 'website',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  <meta name="author" content="agecalconline.com" />
  <meta name="language" content="English" />
  <meta name="theme-color" content="#0070f3" />
  <link rel="canonical" href={canonical} />
  <!-- hreflang Tags --
       The site uses client-side JS i18n (translations.ts), so all 8 language
       variants are served from the same URL. Each alternate correctly points
       to the canonical URL — Google's approved pattern for JS-rendered i18n. -->
  <link rel="alternate" hreflang="en" href={canonical} />
  <link rel="alternate" hreflang="hi" href={canonical} />
  <link rel="alternate" hreflang="es" href={canonical} />
  <link rel="alternate" hreflang="fr" href={canonical} />
  <link rel="alternate" hreflang="ar" href={canonical} />
  <link rel="alternate" hreflang="de" href={canonical} />
  <link rel="alternate" hreflang="pt" href={canonical} />
  <link rel="alternate" hreflang="zh" href={canonical} />
  <link rel="alternate" hreflang="x-default" href={canonical} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Age Calculator — agecalconline.com" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:site" content="@agecalconline" />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="AgeCalc" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Prevent theme flash — must be inline and before body renders -->
  <script is:inline>
    (function() {
      var saved = localStorage.getItem('theme');
      if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    })();
  </script>

  <!-- Preconnect for fonts & Google -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://www.google.com" />
  <link rel="dns-prefetch" href="//www.googletagmanager.com" />
  <link rel="preconnect" href="https://www.googletagmanager.com" />

  <!-- Google Analytics (GA4) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-REQSJY3D4D"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-REQSJY3D4D');
  </script>

  <!-- Global JSON-LD: Organization + Website -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "name": "agecalconline.com",
        "url": "https://agecalconline.com",
        "logo": "https://agecalconline.com/favicon-96x96.png",
        "contactPoint": { "@type": "ContactPoint", "contactType": "Customer Support", "email": "contact@agecalconline.com" }
      },
      {
        "@type": "WebSite",
        "name": "Age Calculator",
        "url": "https://agecalconline.com",
        "description": "Free online calculators for age, pregnancy, work hours, percentages, and life analytics.",
        "potentialAction": {
          "@type": "SearchAction",
          "target": "https://agecalconline.com/?dob={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      }
    ]
  })} />

  <!-- Per-page schema slot (inject SoftwareApplication / FAQPage etc. from individual pages) -->
  <slot name="head" />
</head>
<body>
  <slot name="nav" />
  <Breadcrumbs />
  <main>
    <slot />
  </main>
  <slot name="footer" />
</body>
</html>


