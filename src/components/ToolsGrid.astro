      { href:'/years-between-dates-calculator', icon:'📅', title:'Years Between Dates', desc:'Find out the exact years, months, and days between dates.' },
      { href:'/business-days-calculator', icon:'💼', title:'Business Days', desc:'Calculate working days between dates, excluding weekends.' },
      { href:'/date-addition-calculator', icon:'➕', title:'Date Addition / Subtraction', desc:'Add or subtract days, months, and years from any date.' },
      { href:'/time-duration-calculator', icon:'⏱️', title:'Time Duration', desc:'Calculate exact hours and minutes elapsed between two times.' },
      { href:'/countdown-calculator', icon:'⏳', title:'Countdown Calculator', desc:'Create a live countdown timer to any future date and time.' },
      { href:'/anniversary-calculator', icon:'❤️', title:'Anniversary Calculator', desc:'Calculate exactly how long you have been together.' },
      { href:'/leap-year-calculator', icon:'🐸', title:'Leap Year Calculator', desc:'Check if any year is a leap year and find the next one.' },
      { href:'/chronological-age-calculator', icon:'🕐', title:'Chronological Age', desc:'Calculate your exact age in years, months, days, hours, and seconds.' },
      { href:'/age-difference-calculator', icon:'↔️', title:'Age Difference', desc:'Compare ages of two people in years, months, weeks, and days.' },
      { href:'/birthday-calculator', icon:'🎂', title:'Birthday Calculator', desc:'Countdown to your next birthday and find your birthday twins.' },
      { href:'/future-age-calculator', icon:'🔮', title:'Future Age', desc:'Calculate exactly how old you\'ll be on any future date.' },
      { href:'/reverse-age-calculator', icon:'↩️', title:'Reverse Age', desc:'Find your birth date from a known age.' },
      { href:'/generation-calculator', icon:'👥', title:'Generation Calculator', desc:'Discover your generation and what makes it unique.' },
