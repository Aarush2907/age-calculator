---
<section class="tools-grid section band-light" id="calculators">
  <div class="container">
    <div class="section-header section-header--center" style="margin-bottom:var(--space-2xl)">
      <span class="caption-mono" data-i18n="tools_label">All Calculators</span>
      <h2 class="display-lg" data-i18n="tools_heading">Explore our specialized tools.</h2>
      <p class="body-md text-body" data-i18n="tools_sub">Find the exact calculator you need, organized by category.</p>
    </div>

    <div class="search-container" style="max-width:600px; margin: 0 auto var(--space-4xl) auto;">
      <input type="text" id="tools-search" class="form-input form-input-lg" placeholder="Search for a calculator... (e.g. BMI, Age, Ovulation)" style="width:100%; border-radius: 100px; padding-left: 24px; box-shadow: var(--shadow-2);" />
    </div>

    <div class="categories-list" id="categories-container">
      {categories.map(cat => (
        <div class="category-section">
          <div class="category-header">
            <div class="category-icon">{cat.icon}</div>
            <div>
              <h3 class="display-sm">{cat.name}</h3>
              <p class="body-sm text-body">{cat.desc}</p>
            </div>
          </div>
          <div class="grid-3 tg-grid">
            {cat.tools.map(t => (
              <a href={t.href} class="tg-card card-soft">
                <div class="tg-card__icon">{t.icon}</div>
                <div class="tg-card__title">{t.title}</div>
                <div class="tg-card__desc">{t.desc}</div>
                <div class="tg-card__cta">Calculate →</div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.categories-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-5xl);
}
.category-header {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  margin-bottom: var(--space-xl);
  padding-bottom: var(--space-sm);
  border-bottom: 1px solid var(--hairline);
}
.category-icon {
  font-size: 32px;
  background: var(--canvas);
  width: 64px;
  height: 64px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-lg);
  border: 1px solid var(--hairline);
  box-shadow: var(--shadow-1);
}
.tg-card {
  text-decoration: none; color: inherit;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  display: flex; flex-direction: column; height: 100%;
}
.tg-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-3); border-color: var(--hairline-strong); }
.tg-card__icon { font-size: 28px; margin-bottom: 4px; }
.tg-card__title { font-size: 16px; font-weight: 600; color: var(--ink); letter-spacing: -0.4px; }
.tg-card__desc { font-size: 14px; color: var(--body); line-height: 1.5; flex: 1; margin-top: var(--space-xs); }
.tg-card__cta { font-size: 13px; color: var(--link); font-weight: 600; margin-top: var(--space-md); }
.section-header--center { text-align: center; }
@media (max-width: 600px) {
  .section-header--center { text-align: left; }
  .category-header { flex-direction: column; align-items: flex-start; gap: var(--space-sm); }
}
</style>

<script>
  // Live Search Filtering for Tools
  const searchInput = document.getElementById('tools-search') as HTMLInputElement;
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.toLowerCase();
      const categories = document.querySelectorAll('.category-section');

      categories.forEach(category => {
        let hasVisibleCards = false;
        const cards = category.querySelectorAll('.tg-card');
        
        cards.forEach(card => {
          const title = card.querySelector('.tg-card__title')?.textContent?.toLowerCase() || '';
          const desc = card.querySelector('.tg-card__desc')?.textContent?.toLowerCase() || '';
          
          if (title.includes(query) || desc.includes(query)) {
            (card as HTMLElement).style.display = 'flex';
            hasVisibleCards = true;
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });

        // Hide the entire category if no cards match
        if (hasVisibleCards) {
          (category as HTMLElement).style.display = 'block';
        } else {
          (category as HTMLElement).style.display = 'none';
        }
      });
    });
  }
</script>
