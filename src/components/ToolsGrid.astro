      { href:'/body-fat-calculator', icon:'📏', title:'Body Fat Calculator', desc:'Estimate your body fat percentage using the U.S. Navy method.' },
      { href:'/ideal-weight-calculator', icon:'⚖️', title:'Ideal Weight Calculator', desc:'Calculate your Ideal Body Weight (IBW) based on height.' },
      { href:'/water-intake-calculator', icon:'💧', title:'Water Intake Calculator', desc:'Find out how much water you need daily to stay hydrated.' },
