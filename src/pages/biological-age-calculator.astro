---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ToolsGrid from '../components/ToolsGrid.astro';
---
<BaseLayout title="Biological Age Calculator — What Is Your Real Age? | agecalconline.com" description="Estimate your biological age based on lifestyle habits including exercise, diet, sleep, stress, and smoking. Find out if you're younger or older than your chronological age.">
  <Navbar slot="nav" />
  <section class="section-hero band-white" style="position:relative;overflow:hidden;text-align:center">
    <div style="position:absolute;inset:-40px;background:linear-gradient(135deg,#007cf0,#00dfd8,#7928ca,#ff0080);opacity:0.07;filter:blur(80px);pointer-events:none"></div>
    <div class="container" style="position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;gap:var(--space-xl)">
      <span class="caption-mono">Biological Age Calculator</span>
      <h1 class="display-xl">How old is your body?</h1>
      <p class="body-lg text-body" style="max-width:480px">Your biological age can differ from your chronological age based on lifestyle. Answer a few questions to find out.</p>
    </div>
  </section>

  <section class="section band-light">
    <div class="container" style="max-width:600px">
      <div class="card-lg bio-form">
        <div class="form-group"><label class="form-label" for="bio-dob">Date of Birth</label><input type="date" id="bio-dob" class="form-input" /></div>
        <div class="form-group"><label class="form-label" for="bio-exercise">Exercise Frequency</label>
          <select id="bio-exercise" class="form-select"><option value="5">Daily (5+ days/week)</option><option value="2" selected>Moderate (3–4 days/week)</option><option value="0">Occasional (1–2 days/week)</option><option value="-3">Rarely or Never</option></select>
        </div>
        <div class="form-group"><label class="form-label" for="bio-diet">Diet Quality</label>
          <select id="bio-diet" class="form-select"><option value="4">Excellent (whole foods, balanced)</option><option value="2" selected>Good (mostly healthy)</option><option value="0">Average</option><option value="-3">Poor (processed, junk food)</option></select>
        </div>
        <div class="form-group"><label class="form-label" for="bio-sleep">Sleep Quality</label>
          <select id="bio-sleep" class="form-select"><option value="3">Excellent (7–9 hrs, consistent)</option><option value="1" selected>Good (6–7 hrs)</option><option value="-1">Poor (under 6 hrs)</option><option value="-4">Very Poor (irregular/insomnia)</option></select>
        </div>
        <div class="form-group"><label class="form-label" for="bio-smoke">Smoking</label>
          <select id="bio-smoke" class="form-select"><option value="3" selected>Never smoked</option><option value="0">Former smoker</option><option value="-5">Current smoker</option></select>
        </div>
        <div class="form-group"><label class="form-label" for="bio-stress">Stress Level</label>
          <select id="bio-stress" class="form-select"><option value="3">Low stress</option><option value="1" selected>Moderate stress</option><option value="-2">High stress</option><option value="-5">Very high / chronic stress</option></select>
        </div>
        <button class="btn-primary" id="bio-btn" style="width:100%;justify-content:center;margin-top:var(--space-sm)">Calculate Biological Age</button>
      </div>
    </div>
  </section>

  <section class="section band-dark hidden" id="bio-result">
    <div class="container" style="max-width:600px;text-align:center">
      <div class="card-dark" style="padding:var(--space-3xl)">
        <div style="font-size:48px;margin-bottom:var(--space-md)">🧬</div>
        <div class="caption-mono" style="color:rgba(255,255,255,0.5);margin-bottom:8px">Your Biological Age</div>
        <div class="display-xl" style="color:#fff" id="bio-age">—</div>
        <div class="body-lg" style="color:rgba(255,255,255,0.7);margin-top:var(--space-md)" id="bio-compare">—</div>
        <p class="body-sm" style="color:rgba(255,255,255,0.5);margin-top:var(--space-md)">Based on lifestyle habits. For medical accuracy, consult a healthcare professional.</p>
      </div>
    </div>
  </section>

  <ToolsGrid />
  <Footer slot="footer" />
</BaseLayout>

<style>
.bio-form { display:flex; flex-direction:column; gap:var(--space-md); }
</style>

<script>
document.getElementById('bio-btn')?.addEventListener('click', () => {
  const dob = (document.getElementById('bio-dob') as HTMLInputElement).value;
  if (!dob) return alert('Please enter your date of birth.');
  const birth = new Date(dob);
  const now = new Date();
  const chronoAge = (now.getTime()-birth.getTime())/(365.25*86400000);
  const ex    = parseInt((document.getElementById('bio-exercise') as HTMLSelectElement).value);
  const diet  = parseInt((document.getElementById('bio-diet') as HTMLSelectElement).value);
  const sleep = parseInt((document.getElementById('bio-sleep') as HTMLSelectElement).value);
  const smoke = parseInt((document.getElementById('bio-smoke') as HTMLSelectElement).value);
  const stress= parseInt((document.getElementById('bio-stress') as HTMLSelectElement).value);
  const adjustment = (ex+diet+sleep+smoke+stress);
  const bioAge = Math.max(1, Math.round(chronoAge - adjustment));
  const diff = Math.round(chronoAge) - bioAge;
  (document.getElementById('bio-age') as HTMLElement).textContent=bioAge+' years old';
  const msg = diff>0?`You're biologically ${diff} years YOUNGER than your actual age of ${Math.round(chronoAge)}! 🎉`:diff<0?`You're biologically ${Math.abs(diff)} years older than your actual age. Consider improving your lifestyle. 💪`:`Your biological age matches your actual age of ${Math.round(chronoAge)}.`;
  (document.getElementById('bio-compare') as HTMLElement).textContent=msg;
  document.getElementById('bio-result')!.classList.remove('hidden');
  document.getElementById('bio-result')!.scrollIntoView({behavior:'smooth'});
});
</script>
