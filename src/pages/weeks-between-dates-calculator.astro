---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ToolsGrid from '../components/ToolsGrid.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const title = "Weeks Between Dates Calculator | agecalconline.com";
const description = "Calculate exactly how many weeks and days are between two dates. Free online tool to find the duration in weeks.";
const keywords = "weeks between dates calculator, count weeks between dates, weeks difference calculator, how many weeks between";
const canonical = "https://agecalconline.com/weeks-between-dates-calculator";

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Weeks Between Dates Calculator",
  "applicationCategory": "UtilitiesApplication",
  "url": canonical,
  "description": description,
  "operatingSystem": "Any",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "How do you calculate weeks between two dates?", "acceptedAnswer": { "@type": "Answer", "text": "We first calculate the total number of days between the two dates, then divide by 7. The quotient is the number of full weeks, and the remainder is the extra days." } },
    { "@type": "Question", "name": "How many weeks are in a year?", "acceptedAnswer": { "@type": "Answer", "text": "A standard calendar year has 52 weeks and 1 extra day (or 2 extra days in a leap year). That translates to exactly 52.14 weeks on average." } }
  ]
};
---
<BaseLayout title={title} description={description} keywords={keywords} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <Navbar slot="nav" />

  <section class="section-hero band-white" style="position:relative;overflow:hidden;text-align:center">
    <div style="position:absolute;inset:-40px;background:linear-gradient(135deg,#00dfd8,#f9cb28);opacity:0.08;filter:blur(80px);pointer-events:none"></div>
    <div class="container" style="position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;gap:var(--space-xl)">
      <span class="caption-mono">Date & Time Utilities</span>
      <h1 class="display-xl">Weeks Between Dates Calculator</h1>
      <p class="body-lg text-body" style="max-width:520px">Find out exactly how many full weeks and remaining days exist between any two calendar dates.</p>

      <div class="card-lg" style="width:100%;max-width:600px;text-align:left">
        <div class="grid-2" style="gap:var(--space-md)">
          <div class="form-group">
            <label class="form-label" for="start-date">Start Date</label>
            <input type="date" id="start-date" class="form-input form-input-lg" />
          </div>
          <div class="form-group">
            <label class="form-label" for="end-date">End Date</label>
            <input type="date" id="end-date" class="form-input form-input-lg" />
          </div>
        </div>

        <button class="btn-primary" id="calc-btn" style="margin-top:var(--space-lg);width:100%;justify-content:center">Calculate Weeks</button>
      </div>
    </div>
  </section>

  <section class="section band-light hidden" id="result-section">
    <div class="container" style="max-width:720px;text-align:center">
      <div class="card-lg">
        <div class="caption-mono" style="color:var(--mute);margin-bottom:var(--space-sm)">Exact Difference</div>
        <div class="display-xl" style="color:var(--ink)" id="result-exact">—</div>
        
        <div class="grid-2" style="margin-top:var(--space-2xl);text-align:left;gap:var(--space-md)">
          <div class="card-soft">
            <div class="caption-mono" style="color:var(--mute);margin-bottom:8px">Total Weeks (Decimal)</div>
            <div class="display-sm" id="res-decimal">—</div>
          </div>
          <div class="card-soft">
            <div class="caption-mono" style="color:var(--mute);margin-bottom:8px">Total Days</div>
            <div class="display-sm" id="res-days">—</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section band-white">
    <div class="container" style="max-width:720px">
      <div class="seo-text" style="margin-bottom:var(--space-2xl); color:var(--body); line-height:1.7;">
        <p>Whether you're planning a project in New York, organizing an event in London, or managing a timeline in Mumbai, knowing exactly <strong>how many weeks between dates</strong> is crucial. People around the world frequently search for a reliable <strong>weeks between days calculator</strong> or <strong>weeks between two dates calculator</strong> to effortlessly measure durations. If you are tracking a pregnancy, scheduling a semester, or just curious about <strong>how many weeks in between dates calculator</strong> features, this tool is designed for you. It automatically factors in leap years and exact day counts, making it the perfect <strong>weeks between dates calculator</strong> for users in the US, UK, India, and globally who need precision without manual math.</p>
      </div>
      <h2 class="display-md" style="margin-bottom:var(--space-xl)">Frequently Asked Questions</h2>
      {faqSchema.mainEntity.map(faq => (
        <details class="faq-item">
          <summary class="faq-question">{faq.name}</summary>
          <p class="faq-answer">{faq.acceptedAnswer.text}</p>
        </details>
      ))}
    </div>
  </section>

  <RelatedArticles category="general" />
  <ToolsGrid />
  <Footer slot="footer" />
</BaseLayout>

<script>
  document.getElementById('calc-btn')?.addEventListener('click', () => {
    const startStr = (document.getElementById('start-date') as HTMLInputElement).value;
    const endStr = (document.getElementById('end-date') as HTMLInputElement).value;

    if (!startStr || !endStr) return alert("Please select both dates.");

    let start = new Date(startStr);
    let end = new Date(endStr);
    
    if (start > end) {
      const temp = start;
      start = end;
      end = temp;
    }

    const utcStart = Date.UTC(start.getFullYear(), start.getMonth(), start.getDate());
    const utcEnd = Date.UTC(end.getFullYear(), end.getMonth(), end.getDate());
    
    const totalDays = Math.floor((utcEnd - utcStart) / (1000 * 60 * 60 * 24));
    const weeks = Math.floor(totalDays / 7);
    const days = totalDays % 7;
    const decimalWeeks = totalDays / 7;

    let exactStr = `${weeks} week${weeks !== 1 ? 's' : ''}`;
    if (days > 0) exactStr += `, ${days} day${days !== 1 ? 's' : ''}`;

    (document.getElementById('result-exact') as HTMLElement).textContent = exactStr;
    (document.getElementById('res-decimal') as HTMLElement).textContent = decimalWeeks.toFixed(2);
    (document.getElementById('res-days') as HTMLElement).textContent = totalDays.toLocaleString();

    document.getElementById('result-section')!.classList.remove('hidden');
    document.getElementById('result-section')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  // Set default dates
  const today = new Date();
  const nextDates = new Date(today);
  nextDates.setDate(today.getDate() + 100);
  
  const formatDate = (d: Date) => d.toISOString().split('T')[0];
  (document.getElementById('start-date') as HTMLInputElement).value = formatDate(today);
  (document.getElementById('end-date') as HTMLInputElement).value = formatDate(nextDates);
</script>

<style is:global>
.faq-item { border-top:1px solid var(--hairline); }
.faq-item:last-child { border-bottom:1px solid var(--hairline); }
.faq-question { font-size:16px;font-weight:500;color:var(--ink);cursor:pointer;padding:var(--space-lg) 0;list-style:none;display:flex;justify-content:space-between;align-items:center;letter-spacing:-0.4px; }
.faq-question::after { content:'+';font-size:20px;font-weight:300;color:var(--mute); }
details[open] .faq-question::after { content:'−'; }
.faq-answer { font-size:15px;color:var(--body);line-height:1.7;padding-bottom:var(--space-lg); }
</style>
