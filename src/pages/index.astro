---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import HeroCalculator from '../components/HeroCalculator.astro';
import AgeResult from '../components/AgeResult.astro';
import LifeProgress from '../components/LifeProgress.astro';
import BirthdayDashboard from '../components/BirthdayDashboard.astro';
import MilestoneTracker from '../components/MilestoneTracker.astro';
import PlanetaryAge from '../components/PlanetaryAge.astro';
import LifeStats from '../components/LifeStats.astro';
import GenerationZodiac from '../components/GenerationZodiac.astro';
import LifeCalendar from '../components/LifeCalendar.astro';
import HistoricalTimeline from '../components/HistoricalTimeline.astro';
import ToolsGrid from '../components/ToolsGrid.astro';
import BlogSection from '../components/BlogSection.astro';

const faqs = [
  { q: "What is my age calculator?", a: "An age calculator is a digital tool designed to find your exact chronological age in years, months, days, hours, and seconds based on your specific date of birth." },
  { q: "How to age calculator?", a: "Using our tool is simple: enter your date of birth into the input field at the top of the page and click 'Calculate My Age' to instantly view your comprehensive age breakdown." },
  { q: "How many years calculator age?", a: "Our system calculates the exact number of full years you have been alive by mathematically comparing your birth date against today's date, accounting for leap years." },
  { q: "How to calculate age in calculator?", a: "Simply input your birth date. The calculator's algorithm subtracts your birth date from the current date, automatically factoring in varying month lengths and leap years for 100% precision." },
  { q: "How to age calculator from date of birth?", a: "Just provide your date of birth in the standard format. The system instantly processes this to determine your exact current age without any manual math required." },
  { q: "Age calculator how old was I?", a: "You can use our platform to figure out exactly how old you were on a specific historical date. By adjusting the target date, you can see your precise age during past milestones." },
  { q: "What is my body age calculator?", a: "While our primary tool calculates chronological age, a body (or biological) age calculator is a specialized tool that estimates your physical health age based on lifestyle metrics, diet, and fitness." },
  { q: "What is my age today calculator?", a: "This tool gives you your exact live age as of today. It even includes a live ticking seconds counter so you can watch your precise age grow in real-time." },
  { q: "Age calculator how old am I?", a: "By entering your exact birthdate into the form, you get an immediate, perfectly accurate answer to exactly how old you are right now across multiple time units." },
  { q: "How fit am I for my age calculator?", a: "Biological age calculators assess your fitness, resting heart rate, and lifestyle habits to determine if your body functions younger or older than your actual chronological age." },
  { q: "What age can I retire calculator?", a: "You can use our dedicated retirement calculator feature to determine exactly how many years, months, and days you have left until you reach your target retirement age." },
  { q: "What age will I die calculator?", a: "While no tool can predict the future, our life expectancy calculators use statistical averages and demographic information to estimate lifespans based on your birth year, gender, and region." }
];

const schemaData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---

<BaseLayout
  title="Online Age Calculator | Calculate Exact Age by Date of Birth"
  description="Use our free online chronological age calculator to find your exact age in years, months, and days. Includes dog age, retirement, baby age, and more."
  keywords="age calculator, calculate age from date of birth, exact age calculator, online age calculator, age in years months days, chronological age calculator, how old am I, age by date of birth"
>
  <Navbar slot="nav" />

  <HeroCalculator />
  <AgeResult />
  <LifeProgress />
  <BirthdayDashboard />
  <MilestoneTracker />
  <PlanetaryAge />
  <LifeStats />
  <GenerationZodiac />
  <LifeCalendar />
  <HistoricalTimeline />

  <ToolsGrid />

  <BlogSection />

  <!-- Comprehensive SEO Article -->
  <section class="seo-content section band-white">
    <div class="container seo-inner">
      <div class="seo-text-block">
        <h2 class="display-md" data-i18n="seo_h2_main">The Ultimate Online Age Calculator</h2>
        <p class="body-md" data-i18n="seo_p1">Welcome to AgeCalc Online, a precise and easy-to-use tool designed to help you calculate your exact age in seconds. Whether you're tracking your own milestones, checking eligibility for a form, or simply curious about exactly how many days you've been alive, our platform breaks down your lifespan into years, months, weeks, days, hours, and even seconds. It automatically accounts for leap years and varying month lengths, ensuring perfect mathematical accuracy every time.</p>

        <h3 data-i18n="seo_h3_how">How to Calculate Your Exact Age</h3>
        <p class="body-md" data-i18n="seo_p3">Calculating your age is as simple as entering your date of birth. Our system instantly subtracts your birth date from today's date to determine exactly how old you are right now. You can also adjust the target date to calculate your age on a specific day in the past or future—a helpful feature for historical research, anniversary planning, or checking age requirements for official applications.</p>

        <h3 data-i18n="seo_h3_features">Features of Our Age Calculator</h3>
        <p class="body-md" data-i18n="seo_p5">Our platform offers much more than a basic age calculation. With a single input, you can:</p>
        <ul class="seo-features-list" data-i18n-list="seo_features_list">
          <li data-i18n="seo_feat1">Calculate your exact age from your date of birth.</li>
          <li data-i18n="seo_feat2">Find your age on any past or future date.</li>
          <li data-i18n="seo_feat3">See the total number of days, weeks, months, and hours you have lived.</li>
          <li data-i18n="seo_feat4">Determine the time remaining until your next birthday.</li>
          <li data-i18n="seo_feat5">Calculate age differences between two people.</li>
          <li data-i18n="seo_feat6">Track important life milestones and anniversaries.</li>
          <li data-i18n="seo_feat7">Access specialized tools for retirement planning, life expectancy, and more.</li>
        </ul>

        <h3 data-i18n="seo_h3_specialized">Specialized Age Calculators</h3>
        <p class="body-md" data-i18n="seo_p6">Beyond standard human age, our suite includes specialized calculators designed for every stage of life.</p>

        <h4 class="seo-h4" data-i18n="seo_h4_birthday">Birthday Calculator</h4>
        <p class="body-md" data-i18n="seo_p7">Count down the days until your next birthday. This tool helps you plan celebrations and tells you exactly which day of the week your upcoming milestones will fall on.</p>

        <h4 class="seo-h4" data-i18n="seo_h4_diff">Age Difference Calculator</h4>
        <p class="body-md" data-i18n="seo_p8">Compare the ages of two individuals to find the exact gap in years, months, and days. It's perfect for partners, siblings, or satisfying your curiosity about age gaps.</p>

        <h4 class="seo-h4" data-i18n="seo_h4_pet">Pet Age Calculator</h4>
        <p class="body-md" data-i18n="seo_p9">Convert your pet's age into human years. This calculator accounts for breed size and maturity rates to give you a realistic understanding of your dog or cat's life stage.</p>

        <h4 class="seo-h4" data-i18n="seo_h4_retire">Retirement Calculator</h4>
        <p class="body-md" data-i18n="seo_p10">Plan your future by calculating exactly how much time remains until you reach your target retirement age, helping you align your financial goals with your timeline.</p>

        <h4 class="seo-h4" data-i18n="seo_h4_life">Life Expectancy Calculator</h4>
        <p class="body-md" data-i18n="seo_p11">Explore statistical estimates for your lifespan. By combining demographic data with lifestyle factors, this tool provides a science-backed look at average life expectancy.</p>

        <h4 class="seo-h4" data-i18n="seo_h4_bio">Biological Age Calculator</h4>
        <p class="body-md" data-i18n="seo_p12">Your body might be older or younger than your calendar age. Answer a few questions about your lifestyle, diet, and fitness to estimate how well your body is actually functioning.</p>

        <h3 data-i18n="seo_h3_photo">Can Age Be Calculated From a Photo?</h3>
        <p class="body-md" data-i18n="seo_p13">While AI tools that estimate age from a photograph can be fun, they are far from perfectly accurate. Factors like lighting, genetics, and skincare can easily skew the results. For medical, legal, or official purposes, calculating your age mathematically from your birth date remains the only truly reliable method.</p>

        <h3 data-i18n="seo_h3_why">Why Choose AgeCalc Online?</h3>
        <ul class="seo-features-list" data-i18n-list="seo_why_list">
          <li data-i18n="seo_why1">Fast, instant calculations directly in your browser.</li>
          <li data-i18n="seo_why2">Automatically accounts for leap years and complex calendar math.</li>
          <li data-i18n="seo_why3">Supports past, present, and future date inputs.</li>
          <li data-i18n="seo_why4">Provides comprehensive breakdowns of your time alive.</li>
          <li data-i18n="seo_why5">100% free with no registration or downloads required.</li>
          <li data-i18n="seo_why7">Completely private—your dates of birth are never stored or saved.</li>
        </ul>
        <p class="body-md" data-i18n="seo_p_closing">Whether you need to check your exact age today or track an upcoming milestone, AgeCalc makes the process effortless and perfectly precise.</p>
      </div>
    </div>
  </section>

  <!-- FAQ Section for SEO -->
  <section class="faq section band-white">
    <div class="container faq-inner">
      <div class="section-header" style="margin-bottom:var(--space-3xl)">
        <span class="caption-mono" data-i18n="faq_label">FAQ</span>
        <h2 class="display-lg" data-i18n="faq_heading">Frequently asked questions.</h2>
      </div>
      <div class="faq-list">
        {faqs.map(item => (
          <details class="faq-item">
            <summary class="faq-question">{item.q}</summary>
            <p class="faq-answer">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
    
    <!-- JSON-LD for FAQ SEO -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </section>

  <!-- Company Pages Section -->
  <section class="company-section section band-white">
    <div class="container">
      <div class="section-header" style="margin-bottom:var(--space-3xl)">
        <span class="caption-mono" data-i18n="company_label">Company</span>
        <h2 class="display-md" data-i18n="company_heading">Learn more about us.</h2>
        <p class="body-md" style="max-width:500px;margin-top:var(--space-sm)" data-i18n="company_sub">Transparent, trustworthy, and committed to your privacy.</p>
      </div>
      <div class="company-cards">
        <a href="/about-us" class="company-card">
          <div class="company-card-icon">👥</div>
          <div class="company-card-content">
            <h3 class="company-card-title" data-i18n="company_about_title">About Us</h3>
            <p class="company-card-desc" data-i18n="company_about_desc">Meet the team behind AgeCalc. Learn our story, mission, and why we built the most advanced life analytics platform — for free.</p>
            <span class="company-card-cta" data-i18n="company_about_cta">Learn more →</span>
          </div>
        </a>
        <a href="/contact-us" class="company-card">
          <div class="company-card-icon">💬</div>
          <div class="company-card-content">
            <h3 class="company-card-title" data-i18n="company_contact_title">Contact Us</h3>
            <p class="company-card-desc" data-i18n="company_contact_desc">Have a question, found a bug, or want to suggest a feature? We'd love to hear from you. We reply within 24–48 hours.</p>
            <span class="company-card-cta" data-i18n="company_contact_cta">Get in touch →</span>
          </div>
        </a>
        <a href="/privacy-policy" class="company-card">
          <div class="company-card-icon">🔒</div>
          <div class="company-card-content">
            <h3 class="company-card-title" data-i18n="company_privacy_title">Privacy Policy</h3>
            <p class="company-card-desc" data-i18n="company_privacy_desc">Your data stays in your browser — we never store your date of birth. Read our full privacy policy to understand exactly how we handle your information.</p>
            <span class="company-card-cta" data-i18n="company_privacy_cta">Read policy →</span>
          </div>
        </a>
        <a href="/terms-and-conditions" class="company-card">
          <div class="company-card-icon">📄</div>
          <div class="company-card-content">
            <h3 class="company-card-title" data-i18n="company_terms_title">Terms & Conditions</h3>
            <p class="company-card-desc" data-i18n="company_terms_desc">Understand the rules and disclaimers that govern the use of our free age calculator and life analytics tools.</p>
            <span class="company-card-cta" data-i18n="company_terms_cta">Read terms →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style is:global>
.faq-inner { max-width: 720px; margin: 0 auto; }
.faq-list { display: flex; flex-direction: column; }
.faq-item { border-top: 1px solid var(--hairline); }
.faq-item:last-child { border-bottom: 1px solid var(--hairline); }
.faq-question {
  font-size: 16px; font-weight: 500; color: var(--ink); cursor: pointer;
  padding: var(--space-lg) 0; list-style: none; display: flex; justify-content: space-between;
  align-items: center; letter-spacing: -0.4px;
}
.faq-question::after { content: '+'; font-size: 20px; font-weight: 300; color: var(--mute); transition: transform 0.2s ease; flex-shrink: 0; margin-left: var(--space-md); }
details[open] .faq-question::after { content: '−'; }
.faq-answer { font-size: 15px; color: var(--body); line-height: 1.7; padding-bottom: var(--space-lg); }

/* Section headers */
.section-header { display: flex; flex-direction: column; gap: var(--space-xs); }

/* SEO Section */
.seo-inner { max-width: 800px; margin: 0 auto; }
.seo-text-block { display: flex; flex-direction: column; gap: var(--space-md); padding: var(--space-2xl) 0; border-top: 1px solid var(--hairline); }
.seo-text-block h2 { color: var(--ink); margin-bottom: var(--space-xs); }
.seo-text-block h3 { font-size: 20px; font-weight: 600; color: var(--ink); margin-top: var(--space-md); }
.seo-text-block p { color: var(--body); line-height: 1.7; }
.seo-text-block strong { color: var(--ink); font-weight: 500; }
.seo-h4 { font-size: 16px; font-weight: 600; color: var(--ink); margin-top: var(--space-sm); margin-bottom: calc(var(--space-xs) * -1); }
.seo-features-list { margin: 0; padding-left: var(--space-xl); display: flex; flex-direction: column; gap: var(--space-xs); }
.seo-features-list li { font-size: 15px; color: var(--body); line-height: 1.6; }

@media (max-width: 600px) {
  .faq-question { font-size: 15px; padding: var(--space-md) 0; }
  .faq-answer { font-size: 14px; }
}

@keyframes pulseDot { 0%,100%{transform:scale(1);opacity:1;} 50%{transform:scale(1.4);opacity:0.7;} }
@keyframes fadeInUp { from{opacity:0;transform:translateY(16px);} to{opacity:1;transform:translateY(0);} }

/* Company Section */
.company-cards {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-lg);
}
.company-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  padding: var(--space-xl);
  background: var(--canvas);
  border: 1px solid var(--hairline);
  border-radius: var(--radius-xl);
  text-decoration: none;
  transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  cursor: pointer;
}
.company-card:hover {
  border-color: var(--hairline-strong);
  transform: translateY(-4px);
  box-shadow: var(--shadow-4);
}
.company-card-icon { font-size: 2rem; }
.company-card-content { display: flex; flex-direction: column; gap: var(--space-xs); }
.company-card-title {
  font-size: 16px;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.4px;
  margin: 0;
}
.company-card-desc {
  font-size: 13.5px;
  color: var(--body);
  line-height: 1.6;
  margin: 0;
}
.company-card-cta {
  font-size: 13px;
  font-weight: 600;
  color: var(--link);
  margin-top: var(--space-xs);
  display: block;
  transition: letter-spacing 0.2s ease;
}
.company-card:hover .company-card-cta { letter-spacing: 0.02em; }

@media (max-width: 960px) {
  .company-cards { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 600px) {
  .company-cards { grid-template-columns: 1fr; }
}

</style>
