---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Contact Us | AgeCalc — Get in Touch with agecalconline.com"
  description="Contact the AgeCalc team with questions, feedback, or bug reports. Reach us by email or use the contact form below."
  keywords="contact agecalconline, contact age calculator, get in touch, support"
>
  <Navbar slot="nav" />

  <!-- Hero -->
  <div class="contact-hero">
    <div class="container">
      <div class="contact-hero-inner">
        <span class="policy-badge">Contact</span>
        <h1 class="policy-title">Get in touch.</h1>
        <p class="policy-subtitle">Have a question, found a bug, or want to suggest a new feature? We'd love to hear from you. Fill in the form or email us directly.</p>
        <a href="mailto:contact@agecalconline.com" class="contact-email-link">📧 contact@agecalconline.com</a>
      </div>
    </div>
  </div>

  <!-- Form Section -->
  <section class="contact-main-section section band-white">
    <div class="container contact-center">

      <div class="contact-form-wrapper">
        <div class="contact-form-header">
          <h2 class="contact-form-title">Send us a message</h2>
          <p class="contact-form-subtitle">We typically reply within 24–48 business hours.</p>
        </div>

        <form class="contact-form" id="contact-form" novalidate>
          <div class="form-row">
            <div class="form-group">
              <label for="contact-name" class="form-label">Full Name <span class="required">*</span></label>
              <input
                type="text"
                id="contact-name"
                name="name"
                class="form-input"
                placeholder="John Smith"
                required
                autocomplete="name"
              />
              <span class="form-error" id="name-error">Please enter your name.</span>
            </div>
            <div class="form-group">
              <label for="contact-email" class="form-label">Email Address <span class="required">*</span></label>
              <input
                type="email"
                id="contact-email"
                name="email"
                class="form-input"
                placeholder="john@example.com"
                required
                autocomplete="email"
              />
              <span class="form-error" id="email-error">Please enter a valid email.</span>
            </div>
          </div>

          <div class="form-group">
            <label for="contact-subject" class="form-label">Subject <span class="required">*</span></label>
            <input
              type="text"
              id="contact-subject"
              name="subject"
              class="form-input"
              placeholder="What is your message about?"
              required
            />
            <span class="form-error" id="subject-error">Please enter a subject.</span>
          </div>

          <div class="form-group">
            <label for="contact-message" class="form-label">Message <span class="required">*</span></label>
            <textarea
              id="contact-message"
              name="message"
              class="form-textarea"
              placeholder="Write your message here..."
              rows="6"
              required
            ></textarea>
            <div class="form-meta">
              <span class="form-error" id="message-error">Message must be at least 20 characters.</span>
              <span class="char-count" id="char-count">0 / 2000</span>
            </div>
          </div>

          <button type="submit" class="btn-contact-submit" id="contact-submit">
            <span class="submit-text">Send Message</span>
            <span class="submit-icon">→</span>
          </button>

          <!-- Success / Error states -->
          <div class="form-status form-status--success" id="form-success" aria-live="polite">
            <span class="status-icon">✅</span>
            <div>
              <strong>Message sent!</strong>
              <p>Thank you for reaching out. We'll reply to your email within 24–48 hours.</p>
            </div>
          </div>
          <div class="form-status form-status--error" id="form-error-msg" aria-live="polite">
            <span class="status-icon">❌</span>
            <div>
              <strong>Failed to send.</strong>
              <p>Please try again or email us at contact@agecalconline.com.</p>
            </div>
          </div>
        </form>
      </div>

    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
const form = document.getElementById('contact-form') as HTMLFormElement;
const textarea = document.getElementById('contact-message') as HTMLTextAreaElement;
const charCount = document.getElementById('char-count');
const successEl = document.getElementById('form-success');
const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement;

// Char counter
textarea?.addEventListener('input', () => {
  const len = textarea.value.length;
  if (charCount) charCount.textContent = `${len} / 2000`;
  if (len > 2000) textarea.value = textarea.value.slice(0, 2000);
});

function showError(id: string, show: boolean) {
  const el = document.getElementById(id);
  if (el) el.classList.toggle('visible', show);
}

form?.addEventListener('submit', async (e) => {
  e.preventDefault();

  const name = (document.getElementById('contact-name') as HTMLInputElement).value.trim();
  const email = (document.getElementById('contact-email') as HTMLInputElement).value.trim();
  const subject = (document.getElementById('contact-subject') as HTMLInputElement).value.trim();
  const message = textarea?.value.trim();

  const emailValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);

  showError('name-error', !name);
  showError('email-error', !email || !emailValid);
  showError('subject-error', !subject);
  showError('message-error', !message || message.length < 20);

  if (!name || !email || !emailValid || !subject || !message || message.length < 20) return;

  submitBtn.disabled = true;
  (submitBtn.querySelector('.submit-text') as HTMLElement).textContent = 'Sending…';

  await new Promise(r => setTimeout(r, 1200));

  if (successEl) {
    successEl.classList.add('visible');
    form.reset();
    if (charCount) charCount.textContent = '0 / 2000';
  }
  submitBtn.disabled = false;
  (submitBtn.querySelector('.submit-text') as HTMLElement).textContent = 'Send Message';
});
</script>

<style is:global>
/* Contact Hero */
.contact-hero {
  background: linear-gradient(135deg, var(--canvas-soft-2) 0%, var(--canvas) 100%);
  border-bottom: 1px solid var(--hairline);
  padding: var(--space-5xl) 0 var(--space-4xl);
}
.contact-hero-inner {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  max-width: 600px;
}
.contact-email-link {
  display: inline-flex;
  align-items: center;
  gap: var(--space-xs);
  font-size: 15px;
  font-weight: 500;
  color: var(--link);
  text-decoration: none;
  margin-top: var(--space-xs);
  transition: opacity 0.15s;
}
.contact-email-link:hover { opacity: 0.75; text-decoration: underline; }

/* Center layout */
.contact-center {
  display: flex;
  justify-content: center;
}
.contact-form-wrapper {
  width: 100%;
  max-width: 680px;
}

/* Form */
.contact-form-header { margin-bottom: var(--space-2xl); }
.contact-form-title {
  font-size: 24px;
  font-weight: 700;
  letter-spacing: -0.6px;
  color: var(--ink);
  margin: 0 0 var(--space-xs);
}
.contact-form-subtitle {
  font-size: 14px;
  color: var(--body);
  margin: 0;
}
.contact-form {
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}
.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-lg);
}
.form-group {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}
.form-label {
  font-size: 13px;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: -0.2px;
}
.required { color: #ef4444; }
.form-input,
.form-textarea {
  width: 100%;
  padding: 10px 14px;
  font-size: 14px;
  color: var(--ink);
  background: var(--canvas);
  border: 1px solid var(--hairline);
  border-radius: var(--radius-md);
  font-family: var(--font-sans);
  transition: border-color 0.15s, box-shadow 0.15s;
  outline: none;
  box-sizing: border-box;
}
.form-input:focus,
.form-textarea:focus {
  border-color: var(--link);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--link) 15%, transparent);
}
.form-textarea { resize: vertical; min-height: 140px; line-height: 1.6; }
.form-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.char-count {
  font-size: 12px;
  color: var(--mute);
  font-family: var(--font-mono);
  flex-shrink: 0;
}
.form-error {
  font-size: 12px;
  color: #ef4444;
  display: none;
}
.form-error.visible { display: block; }

/* Submit Button */
.btn-contact-submit {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-sm);
  background: var(--ink);
  color: var(--on-primary);
  font-size: 15px;
  font-weight: 600;
  padding: 14px 28px;
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: opacity 0.15s, transform 0.15s;
  letter-spacing: -0.3px;
  width: 100%;
  border: none;
}
.btn-contact-submit:hover:not(:disabled) {
  opacity: 0.85;
  transform: translateY(-1px);
}
.btn-contact-submit:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}
.submit-icon { font-size: 1.1rem; transition: transform 0.2s; }
.btn-contact-submit:hover .submit-icon { transform: translateX(3px); }

/* Status Messages */
.form-status {
  display: none;
  align-items: flex-start;
  gap: var(--space-md);
  padding: var(--space-md) var(--space-lg);
  border-radius: var(--radius-md);
  font-size: 14px;
}
.form-status.visible { display: flex; }
.form-status--success {
  background: #dcfce7;
  border: 1px solid #86efac;
  color: #166534;
}
.form-status--error {
  background: #fee2e2;
  border: 1px solid #fca5a5;
  color: #991b1b;
}
html[data-theme="dark"] .form-status--success {
  background: rgba(22,163,74,0.15);
  border-color: rgba(22,163,74,0.3);
  color: #4ade80;
}
html[data-theme="dark"] .form-status--error {
  background: rgba(239,68,68,0.15);
  border-color: rgba(239,68,68,0.3);
  color: #f87171;
}
.form-status strong { display: block; font-weight: 700; margin-bottom: 2px; }
.form-status p { margin: 0; opacity: 0.85; }
.status-icon { font-size: 1.4rem; flex-shrink: 0; }

@media (max-width: 600px) {
  .form-row { grid-template-columns: 1fr; }
}
</style>
