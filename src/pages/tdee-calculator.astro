---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ToolsGrid from '../components/ToolsGrid.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const title = "TDEE Calculator — Total Daily Energy Expenditure | agecalconline.com";
const description = "Calculate your Total Daily Energy Expenditure (TDEE) to find out how many calories you burn per day based on your activity level.";
const keywords = "TDEE calculator, total daily energy expenditure, maintenance calories, daily calorie needs, calculate tdee";
const canonical = "https://agecalconline.com/tdee-calculator";

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "TDEE Calculator",
  "applicationCategory": "HealthApplication",
  "url": canonical,
  "description": description,
  "operatingSystem": "Any",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "What is TDEE?", "acceptedAnswer": { "@type": "Answer", "text": "Total Daily Energy Expenditure (TDEE) is the total number of calories you burn in a given day, accounting for both your Basal Metabolic Rate (BMR) and your physical activity level." } },
    { "@type": "Question", "name": "How do I use my TDEE?", "acceptedAnswer": { "@type": "Answer", "text": "Your TDEE is your maintenance calories. If you eat this amount, your weight will stay the same. To lose weight, eat fewer calories than your TDEE. To gain muscle/weight, eat more." } }
  ]
};
---
<BaseLayout title={title} description={description} keywords={keywords} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <Navbar slot="nav" />

  <section class="section-hero band-white" style="position:relative;overflow:hidden;text-align:center">
    <div style="position:absolute;inset:-40px;background:linear-gradient(135deg,#50e3c2,#00dfd8);opacity:0.08;filter:blur(80px);pointer-events:none"></div>
    <div class="container" style="position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;gap:var(--space-xl)">
      <span class="caption-mono">Health & Fitness</span>
      <h1 class="display-xl">TDEE Calculator</h1>
      <p class="body-lg text-body" style="max-width:520px">Find out exactly how many calories you burn per day based on your body stats and activity level.</p>

      <div class="card-lg" style="width:100%;max-width:600px;text-align:left">
        <div class="grid-2" style="gap:var(--space-md)">
          <div class="form-group">
            <label class="form-label" for="tdee-gender">Gender</label>
            <select id="tdee-gender" class="form-select form-input-lg">
              <option value="male">Male</option>
              <option value="female">Female</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label" for="tdee-age">Age (years)</label>
            <input type="number" id="tdee-age" class="form-input form-input-lg" min="15" max="100" value="30" />
          </div>
        </div>

        <div class="grid-2" style="gap:var(--space-md);margin-top:var(--space-md)">
          <div class="form-group">
            <label class="form-label" for="tdee-height">Height (cm)</label>
            <input type="number" id="tdee-height" class="form-input form-input-lg" min="100" max="250" value="170" />
          </div>
          <div class="form-group">
            <label class="form-label" for="tdee-weight">Weight (kg)</label>
            <input type="number" id="tdee-weight" class="form-input form-input-lg" min="30" max="300" value="70" />
          </div>
        </div>

        <div class="form-group" style="margin-top:var(--space-md)">
          <label class="form-label" for="tdee-activity">Activity Level</label>
          <select id="tdee-activity" class="form-select form-input-lg">
            <option value="1.2">Sedentary (office job, little/no exercise)</option>
            <option value="1.375">Lightly Active (light exercise 1-3 days/week)</option>
            <option value="1.55" selected>Moderately Active (moderate exercise 3-5 days/week)</option>
            <option value="1.725">Very Active (hard exercise 6-7 days/week)</option>
            <option value="1.9">Extremely Active (physical job or training 2x/day)</option>
          </select>
        </div>

        <button class="btn-primary" id="calc-btn" style="margin-top:var(--space-lg);width:100%;justify-content:center">Calculate TDEE</button>
      </div>
    </div>
  </section>

  <section class="section band-light hidden" id="result-section">
    <div class="container" style="max-width:720px;text-align:center">
      <div class="card-lg">
        <div class="caption-mono" style="color:var(--mute);margin-bottom:var(--space-sm)">Your Maintenance Calories</div>
        <div class="display-xl" style="color:var(--ink)" id="result-tdee">—</div>
        <div class="body-lg text-body" style="margin-top:var(--space-xs)">calories / day</div>
        
        <div class="grid-2" style="margin-top:var(--space-2xl);text-align:left;gap:var(--space-md)">
          <div class="card-soft">
            <div class="caption-mono" style="color:var(--mute);margin-bottom:8px">For Fat Loss (-500 kcal)</div>
            <div class="display-sm" id="res-loss" style="color:#ff6b9d">—</div>
          </div>
          <div class="card-soft">
            <div class="caption-mono" style="color:var(--mute);margin-bottom:8px">For Muscle Gain (+500 kcal)</div>
            <div class="display-sm" id="res-gain" style="color:#50e3c2">—</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section band-white">
    <div class="container" style="max-width:720px">
      <h2 class="display-md" style="margin-bottom:var(--space-xl)">Frequently Asked Questions</h2>
      {faqSchema.mainEntity.map(faq => (
        <details class="faq-item">
          <summary class="faq-question">{faq.name}</summary>
          <p class="faq-answer">{faq.acceptedAnswer.text}</p>
        </details>
      ))}
    </div>
  </section>

  <RelatedArticles category="bmi" />
  <ToolsGrid />
  <Footer slot="footer" />
</BaseLayout>

<script>
  document.getElementById('calc-btn')?.addEventListener('click', () => {
    const gender = (document.getElementById('tdee-gender') as HTMLSelectElement).value;
    const age = parseFloat((document.getElementById('tdee-age') as HTMLInputElement).value);
    const height = parseFloat((document.getElementById('tdee-height') as HTMLInputElement).value);
    const weight = parseFloat((document.getElementById('tdee-weight') as HTMLInputElement).value);
    const activity = parseFloat((document.getElementById('tdee-activity') as HTMLSelectElement).value);

    if (!age || !height || !weight) return alert("Please fill in all fields.");

    // Mifflin-St Jeor Equation for BMR
    let bmr = (10 * weight) + (6.25 * height) - (5 * age);
    if (gender === 'male') {
      bmr += 5;
    } else {
      bmr -= 161;
    }

    const tdee = bmr * activity;

    (document.getElementById('result-tdee') as HTMLElement).textContent = Math.round(tdee).toLocaleString();
    (document.getElementById('res-loss') as HTMLElement).textContent = Math.round(tdee - 500).toLocaleString() + ' kcal';
    (document.getElementById('res-gain') as HTMLElement).textContent = Math.round(tdee + 500).toLocaleString() + ' kcal';

    document.getElementById('result-section')!.classList.remove('hidden');
    document.getElementById('result-section')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>

<style is:global>
.faq-item { border-top:1px solid var(--hairline); }
.faq-item:last-child { border-bottom:1px solid var(--hairline); }
.faq-question { font-size:16px;font-weight:500;color:var(--ink);cursor:pointer;padding:var(--space-lg) 0;list-style:none;display:flex;justify-content:space-between;align-items:center;letter-spacing:-0.4px; }
.faq-question::after { content:'+';font-size:20px;font-weight:300;color:var(--mute); }
details[open] .faq-question::after { content:'−'; }
.faq-answer { font-size:15px;color:var(--body);line-height:1.7;padding-bottom:var(--space-lg); }
</style>
